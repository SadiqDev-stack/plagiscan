{
  "name": "plagiscan",
  "version": "1.0.0",
  "description": "Plagiarism Checker Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.sadiq.plagiscan",
    "productName": "PlagiScan",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "renderer.js",
      "preload.js",
      "menu.js",
      "icon.ico",
      "logo.png"
    ],
    "win": {
      "target": ["nsis", "portable"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PlagiScan"
    },
    "portable": {
      "artifactName": "PlagiScan.exe"
    }
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^24.13.3"
  }
}